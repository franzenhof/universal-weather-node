{
  "apiVersion": 1,
  "device": {
    "name": "Weather Mast",
    "hostname": "weather-mast",
    "uptimeSec": 180064
  },
  "firmware": {
    "version": "2.0.0"
  },
  "hardware": {
    "board": "V3",
    "pcbRev": 20
  },
  "units": {
    "system": "metric",
    "temp": "C",
    "pressure": "hPa",
    "wind": "m/s",
    "rain": "mm",
    "rainRate": "mm/h",
    "cloudBase": "m",
    "tempTrend": "K"
  },
  "measurement": {
    "cycleSec": 300,
    "windSampleSec": 1,
    "mqttWindAggregation": "interval",
    "altitudeM": 560,
    "clockSynced": true,
    "timeZone": "CET-1CEST,M3.5.0,M10.5.0/3"
  },
  "history": {
    "ranges": [
      {
        "range": "24h",
        "bucketSec": 300,
        "maxPoints": 288
      },
      {
        "range": "7d",
        "bucketSec": 3600,
        "maxPoints": 168
      }
    ]
  },
  "outputs": {
    "wifi": true,
    "webApi": true,
    "mqtt": true,
    "mqttCommands": true,
    "lorawan": true,
    "loxone": false,
    "updateCheck": false,
    "weatherNetworks": ["windy"]
  },
  "available": {
    "temp": true,
    "humidity": true,
    "pressure": true,
    "wind": true,
    "rain": true,
    "uvIndex": true,
    "light": false,
    "ds18b20Probes": 3,
    "battery": true,
    "wirelessSensors": false,
    "uvSensorVolts": true,
    "wind2": true,
    "auxAnalog": false,
    "auxPulses": false,
    "heater": true,
    "fan": true,
    "victron": true
  },
  "sources": {
    "tempHum": "board",
    "wind": "board",
    "rain": "board",
    "uv": "board",
    "light": "none"
  }
}
