	(gr_text "J16 EXPANSION"
		(at 78.09 53.44 0)
		(layer "B.SilkS")
		(uuid "6d311a8a-b871-4bfa-8390-e2abd0dfb035")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.12)
			)
			(justify mirror)
		)
	)
	(gr_text "SENSOR BUSES - 3.3V LOGIC ONLY\nJ9 I2C: 1 3V3 | 2 SDA | 3 SCL | 4 GND\nBME280: SDA GPIO41 / SCL GPIO42.\nJP1 SDA / JP11 SCL: fit for extra 4k7\npull-ups; check total bus pull-up load.\nJ10 1-Wire: 1 GND | 2 3V3 | 3 DQ\nDS18B20 DQ GPIO5; powered 3-wire bus.\n3V3 sensor rail: F3 PTC 0.25A nominal;\n1-Wire branch F4 PTC 0.10A nominal.\nPTC ratings derate with temperature."
		(at 65.895953 67.491948 0)
		(layer "B.SilkS")
		(uuid "8a266ae4-18bf-47c0-b284-2f3ff534e13f")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.13)
			)
			(justify mirror)
		)
	)
	(gr_text "FIRST POWER-UP / HARDWARE\nHeltec WiFi LoRa 32 V3/V3.1/V3.2;\nUSB end at USB-C mark; align sockets.\nRemove module; current-limit supply.\nSelect JP8; verify TP3=5V, no shorts."
		(at 66.976906 77.77206 0)
		(layer "B.SilkS")
		(uuid "8e1ec69c-be8f-4ab6-ab58-06a81fc20afe")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.13)
			)
			(justify mirror)
		)
	)
	(gr_text "POWER / JP8 - ONE SOURCE ONLY\nJ3: 1 VIN 6-29.2V | 2 EXT 5V | 3 GND\nJP8 1-2: VIN buck -> 5V rail\nJP8 2-3: external regulated 5V\nUSB only: remove JP8; disconnect J3\nNEVER USB + VIN or external 5V!\nNo auto-mux / no reverse-current isolation.\nPower OFF + discharge before rewiring.\nFit ONE shunt; never bridge all 3 pins."
		(at 73.653097 111.847971 0)
		(layer "B.SilkS")
		(uuid "504e94a1-17b0-49c1-8332-06a53ccea7fe")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.13)
			)
			(justify mirror)
		)
	)
	(gr_text "FIRST POWER-UP / CONTINUED\nPower OFF; fit module; check TP4=3.3V.\nGPIO20 ID about 1.65V -> PCB v2.0.\nEnable/configure optional I/O in FW.\nNo powered sensor signals with MCU OFF."
		(at 88.529287 93.77206 0)
		(layer "B.SilkS")
		(uuid "4629a958-bfd6-4e73-82d0-be43698b78a4")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.13)
			)
			(justify mirror)
		)
	)
	(gr_text "PINOUTS: actual connector pin numbers,\nNOT left-to-right order in this view.\nPin 1: square pad / connector marking."
		(at 89.015002 85.484105 0)
		(layer "B.SilkS")
		(uuid "2779ceb4-ac17-4a34-a78d-30ca9ffb5936")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.13)
			)
			(justify mirror)
		)
	)
	(gr_text "AUX / J11 - ANALOG + PULSE\nPins: 1 3V3 | 2 AIN | 3 PULSE | 4 GND\nAIN GPIO4 ADC1; R24 series = 10k.\nR25 absent: scale 1; input <=3.3V\n(useful ADC range about 0-3.1V).\nFit R25 15k for 0-5V; scale 1.66667\n(downlink x1000 = 1667; 5V -> 3V ADC).\nPULSE GPIO48: reed / open collector;\npull-up + RC + inverting Schmitt.\nNever connect battery / 12V to AUX."
		(at 92.700715 67.491948 0)
		(layer "B.SilkS")
		(uuid "f1af3448-8181-48f0-8733-4052241f9f9a")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.13)
			)
			(justify mirror)
		)
	)
	(gr_text "VE.DIRECT / POWER + ISOLATION\nV+ from Victron powers isolated side.\nUse original cable / verify pin numbers.\nDo NOT bridge ISO GND to board GND.\nNo RS232 +/-voltage or RS485 interface."
		(at 93.295954 77.77206 0)
		(layer "B.SilkS")
		(uuid "02f9c1ea-4f32-4c41-9fee-7241db480008")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.13)
			)
			(justify mirror)
		)
	)
	(gr_text "EXPANSION / TEST POINTS\nJ16 DNP: 1 GND | 2 3V3 | 3 SDA\n4 SCL | 5 GPIO19 | 6 5V\nGPIO19 also controls vane supply:\nLOW = vane ON; not a free output.\nJ16 signals: 3.3V, not field protected.\nTP1/TP5 GND | TP2 protected VIN\nTP3 5V | TP4 3V3; use GND reference.\nADC probe pads: C17 AUX / C27 UV."
		(at 99.557857 123.847971 0)
		(layer "B.SilkS")
		(uuid "1bd0903f-0f36-4b59-b261-2c50e3ad7977")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.13)
			)
			(justify mirror)
		)
	)
	(gr_text "UV / J17 / JP10 - GPIO3 ADC1\nJ17: 1 GND | 2 SIGNAL | 3 3V3 | 4 5V\nPower sensor from ONE supply pin only.\nJP10 1-2: input 0-3.3V; scale 1.10989\nJP10 2-3: input 0-5V; scale 1.66534\nSelect range BEFORE applying signal.\n5V range: 5V input -> 3.0024V ADC.\nSensor volts != UVI: calibrate sensor.\nTVS + 10k + rail clamps + RC filter."
		(at 103.515003 110.347971 0)
		(layer "B.SilkS")
		(uuid "8100874d-f096-4a8a-9407-b04f0d45e3e5")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.13)
			)
			(justify mirror)
		)
	)
	(gr_text "PROTECTION / MECHANICAL LIMITS\nVIN + EXT 5V: MOSFET reverse protection.\nTVS/diodes: transients, NOT DC overvoltage\ndisconnect, lightning or surge approval.\nD1/D4 MUST be bidirectional CA parts.\nF7 6.3A main / F5 4A heater fuse.\nFuse rating is NOT allowed load current!\nThermal test; NO continuous 2A guarantee.\n100x100mm; M3 centres 92x92mm.\nWashers/standoffs <=7mm OD; mind underside."
		(at 116.93405 89.491948 0)
		(layer "B.SilkS")
		(uuid "edb8f085-240c-4cc0-a2ec-81352a6cb3d3")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.13)
			)
			(justify mirror)
		)
	)
	(gr_text "HEATER / FAN - CHECK LOAD RATINGS\nJ12: 1 +V = protected VIN | 2 HEAT-\nHeater <=3A; low-side PWM (GPIO38).\nHEAT- is switched, NOT permanent GND.\nJ13: 1 FAN+ | 2 GND | 3 TACH\nFan: high-side PWM (GPIO39).\nJP9 1-2: 5V, <=0.5A (default)\nJP9 2-3: protected VIN, <=1A\nUse a fan rated for selected voltage.\nCombined 5V loads share source budget."
		(at 119.224527 59.491948 0)
		(layer "B.SilkS")
		(uuid "4eec322c-5c5d-4eeb-8755-291f289db8b9")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.13)
			)
			(justify mirror)
		)
	)
	(gr_text "UNIVERSAL WEATHER NODE v2.0 / franzenhof.com / CERN-OHL-P v2"
		(at 120.005478 51.69615 0)
		(layer "B.SilkS")
		(uuid "b16aaaef-b3ac-4964-acf2-1e95f3cad93e")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.13)
			)
			(justify mirror)
		)
	)
	(gr_text "DAVIS WIND / RAIN\nJ5 WIND: 1 GND | 2 SPD | 3 DIR | 4 3V3\nJ4 RJ11: 2 3V3 | 3 DIR | 4 GND | 5 SPD\nRJ11 contacts 1/6 unused; use pin nos.\nJ7 RAIN: 1 GND | 2 RAIN\nJ6 RJ11: 3 RAIN | 4 GND; 1/2/5/6 NC\nRJ11 + screw terminal are parallel.\nJP2 OPEN: Davis potentiometer vane.\nJP2 FITTED: extra 4k7 vane pull-up.\nSpeed GPIO6 / rain GPIO7 / dir GPIO2."
		(at 120.276907 75.991948 0)
		(layer "B.SilkS")
		(uuid "37cc2295-8b8a-44af-bba2-8cbe25fe51bd")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.13)
			)
			(justify mirror)
		)
	)
	(gr_text "ISOLATED VE.DIRECT / J14 + J15\nBoth: 1 ISO GND | 2 TX | 3 RX | 4 V+\nTX = node -> Victron RX (GPIO34)\nRX = Victron TX -> node (GPIO33)"
		(at 130.995953 112.128083 0)
		(layer "B.SilkS")
		(uuid "815abd74-7e35-4616-a1de-ee01c7f4aa0b")
